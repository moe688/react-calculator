{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "jsx": "react-jsx",

    "allowJs": true,

    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"]
}